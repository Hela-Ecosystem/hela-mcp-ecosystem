{"version":3,"term":{"cols":100,"rows":34},"timestamp":1794584424,"idle_time_limit":1.0,"command":"bash /tmp/hela-profile-showcase.sh","title":"HeLa profile-aware Needle and Mirage installer","env":{"SHELL":"/bin/bash"}}
[0.002, "o", "\u001b[1;36mHeLa MCP Ecosystem — profile-aware capabilities\u001b[0m\r\n\r\n\u001b[1;33m$ node setup.mjs --help\u001b[0m\r\n"]
[0.072, "o", "Usage: node setup.mjs [doctor|mode] [OPTIONS]\r\n  --mode individual|runtime|docker|docker-runtime|nix\r\n  --profile ID          Any of the eight canonical profiles (default minimal)\r\n  --prefix PATH         Managed installation directory; existing unmanaged directories are refused\r\n  --snapshot TAG|FILE   Exact snapshot (default latest-stable)\r\n  --client NAME         Generate a client fragment, never overwrite live client settings (default skip)\r\n  --out FILE            Explicit generated fragment destination; refuses existing files\r\n  --workspace PATH      Workspace exposed to installed tools (default PREFIX/workspace)\r\n  --runtime             Alias for runtime, or docker-runtime with --mode docker\r\n  --with-runtime        Also build runtime with an individual installation\r\n  --without-model       Explicitly omit the local Needle engine/model (core MCP only)\r\n  --transport stdio|http Runtime transport (HTTP is loopback-only; listener started explicitly)\r\n  --port PORT           HTTP listener port (default 8080)\r\n  --dev                 Explicitly follow each snapshot's branch instead of its pin\r\n  --reconfigure         Generate a new fragment from a verified existing installation\r\n  --non-interactive     No prompts; missing/invalid arguments fail immediately\r\n  --image NAME          Docker image tag override\r\n  --root PATH           Metadata source checkout (default this checkout)\r\n  --help                Show help\r\n\r\nDoctor accepts --prefix/--mode/--profile/--runtime/--json, or --url URL for a running HTTP endpoint.\r\nMode switching reuses an existing managed prefix and preserves its data directories:\r\n  node setup.mjs mode --prefix PATH --mode individual|runtime|docker|docker-runtime|nix [--client NAME]\r\nHardware/providers are separate checks.\r\nProfile capabilities are automatic: every canonical profile includes Needle through Mitosis; profiles containing Cytosol (dev-workspace, research, web-devops, all) also install the managed Mirage Python bridge.\r\nNode 22+ required; --mode nix bootstraps the pinned Nix development environment.\r\nOptional provider keys are read from environment, never CLI arguments. Client settings are merged manually.\r\n"]
[0.004, "o", "\r\n\u001b[1;33m$ profile capability matrix\u001b[0m\r\n"]
[0.029, "o", "PROFILE          NEEDLE  MIRAGE  INSTALL RESULT\r\n"]
[0.000, "o", "────────────────────────────────────────────────\r\n"]
[0.000, "o", "minimal          true    false   Needle\r\ndev-workspace    true    true    Needle + Mirage\r\n"]
[0.000, "o", "headless-server  true    false   Needle\r\n"]
[0.000, "o", "research         true    true    Needle + Mirage\r\n"]
[0.000, "o", "web-devops       true    true    Needle + Mirage\r\n"]
[0.000, "o", "android-testing  true    false   Needle\r\n"]
[0.000, "o", "3d-modeling      true    false   Needle\r\n"]
[0.000, "o", "all              true    true    Needle + Mirage\r\n"]
[0.000, "o", "\r\nDefault when omitted: minimal → Needle, no Mirage\r\n"]
[0.000, "o", "Cytosol profiles: dev-workspace, research, web-devops, all → both capabilities\r\n"]
[0.003, "o", "\r\n\u001b[1;32mREADY — capabilities follow the selected profile.\u001b[0m\r\n"]
[0.000, "x", "0"]
